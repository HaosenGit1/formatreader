{
  "name": "formatreader",
  "private": true,
  "version": "0.1.0",
  "description": "Drop any file into your browser — it detects the format and shows it. Nothing is uploaded.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:portable": "node scripts/patch-deps.mjs && vite build --mode portable",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "samples": "node scripts/make-samples.mjs",
    "deploy": "bash scripts/deploy.sh",
    "predev": "node scripts/patch-deps.mjs && node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/patch-deps.mjs && node scripts/copy-vendor.mjs",
    "pretest": "node scripts/patch-deps.mjs && node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "1.29.0",
    "ag-psd": "34.1.0",
    "buffer": "6.0.3",
    "dicom-parser": "1.8.21",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.18",
    "dxf-parser": "1.1.2",
    "echarts": "6.1.0",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "foliate-js": "1.0.1",
    "highlight.js": "11.12.0",
    "hwp.js": "0.0.3",
    "jschardet": "4.1.0",
    "libarchive.js": "2.0.2",
    "libheif-js": "1.23.5",
    "marked": "18.2.1",
    "mdb-reader": "3.2.1",
    "mpegts.js": "1.8.2",
    "music-metadata": "12.3.4",
    "occt-import-js": "0.0.23",
    "postal-mime": "4.2.1",
    "pptx-preview": "1.0.7",
    "sql.js": "1.16.0",
    "three": "0.187.0",
    "utif": "3.1.0",
    "web-ifc": "0.0.78",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/sql.js": "1.4.11",
    "@types/three": "0.187.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "echarts": "6.1.0",
    "uuid": "11.1.1"
  }
}
